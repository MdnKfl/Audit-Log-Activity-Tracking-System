// Main-database schema: business user accounts and their transactionally written audit outbox.

generator client {
  provider = "prisma-client"
  output   = "../../generated/main-client"
}

datasource db {
  provider = "postgresql"
}

/// Business accounts used by registration, JWT authentication, and user-management endpoints.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(100)
  address      String?  @db.VarChar(500)
  phoneNumber  String?  @map("phone_number") @db.VarChar(30)
  /// Optional sign-in name used by administrator accounts; unique when present.
  username     String?  @unique @db.VarChar(32)
  /// Required by public USER registration; nullable so admins can use username-only sign-in.
  email        String?  @unique @db.VarChar(254)
  passwordHash String?  @map("password_hash")
  role         String   @default("USER") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

/// Internal event staging table; each business mutation and its event are committed together.
model OutboxEvent {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @unique @map("event_id") @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(100)
  actorId      String?  @map("actor_id") @db.Uuid
  actorType    String   @map("actor_type") @db.VarChar(20)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.Uuid
  outcome      String   @db.VarChar(20)
  metadata     Json?
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)
  status       String   @default("PENDING") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  lastError    String?  @map("last_error")

  @@index([status, createdAt])
  @@map("outbox_events")
}
