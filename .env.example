# Main database contains application users and the transactional outbox.
DATABASE_URL="postgresql://nestsms:devpassword@localhost:5433/audit_dev"
# Separate database contains permanent audit_logs records written by the worker.
AUDIT_DATABASE_URL="postgresql://nestsms:devpassword@localhost:5433/audit_logs_dev"
# Redis transports audit jobs from the outbox publisher to the audit worker.
REDIS_URL="redis://localhost:6379"
# HTTP port for the Express API.
PORT="3000"
# Signing key for JWTs; replace with at least 32 random bytes for local use.
JWT_SECRET="replace-with-64-hex-characters-from-openssl-rand-hex-32"
# Used only by npm run auth:bootstrap-admin to seed the first superadmin.
BOOTSTRAP_ADMIN_EMAIL="superadmin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="superadmin@123"
